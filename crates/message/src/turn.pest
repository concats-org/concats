NEWLINE = _{ "\r\n" | "\n" }
hspace = _{ " " | "\t" }

commit_message = {
    SOI ~ subject ~ NEWLINE ~ NEWLINE ~ (transcript ~ NEWLINE ~ NEWLINE)? ~ session ~ (NEWLINE ~ agent)? ~ NEWLINE* ~ EOI
}

subject = @{ (!NEWLINE ~ ANY)+ }

transcript = { entry ~ ((hspace | NEWLINE)+ ~ entry)* }
entry = _{ prompt | response }

prompt = { "<prompt>" ~ body ~ "</prompt>" }
response = { "<response>" ~ body ~ "</response>" }

body = @{ (!"<" ~ ANY)* }

session = { "Session: " ~ value }
agent = { "Agent: " ~ value }

value = @{ (!NEWLINE ~ ANY)+ }
